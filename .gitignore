# =====================================================================
# 公開してはいけない物の一覧です。1行でも消すと、次の `git add .` で
# 実在する利用者のデータや鍵が公開リポジトリに入ります。
# =====================================================================

# --- 鍵・秘密(env相当。本来は ../.pusyuuHiddenFiles/ に置く物) ---
.pusyuuHiddenFiles/
.env
.env.*
*_key.php
*_credentials.php
private_key_pem.php
*.pem

# --- 運用中に溜まる利用者データ・ログ・作業ファイル ---
*.jsonl
*.sqlite
*.sqlite3
*.db
*.enc
*.lock
*.bak
*.tmp
*.log
.lock

# --- OS・エディタ・ツール ---
.claude/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- main 固有の運用データ ---
pusyuusystem/apis/pusyuu_push/*/
pusyuusystem/apis/pusyuu_ips/storage/
pusyuusystem/pages/contact/data.json
pusyuusystem/pages/counter/count.dat
pusyuusystem/documents/productUsage.json
# 問い合わせフォームの公開鍵は機密ではない配布物なので戻す
!pusyuusystem/pages/contact/contact_public_key.php

# --- 個別のリポジトリで公開している共有ライブラリ(README の「共有ライブラリ」を参照) ---
pusyuusystem/scripts/php_scripts/meikiee_client.php
pusyuusystem/scripts/php_scripts/panic_handler.php
pusyuusystem/scripts/php_scripts/pusyuu_registry_client.php
pusyuusystem/scripts/php_scripts/pusyuu_session.php
pusyuusystem/scripts/php_scripts/rate_limiter.php
pusyuusystem/scripts/php_scripts/usage_tracker.php

# --- 個別のリポジトリで公開しているAPIとスクリプト(README の「個別に公開している部品」を参照) ---
pusyuusystem/apis/
pusyuusystem/scripts/dragg-and-drop.js
pusyuusystem/scripts/internet_checker.js
pusyuusystem/scripts/notify-sound.js
pusyuusystem/scripts/privacy_notice.js
pusyuusystem/scripts/push-subscribe.js
pusyuusystem/scripts/pusyuuWallpaper.js
pusyuusystem/scripts/request-indicator.js
pusyuusystem/scripts/touch-device-tool-tip.js
pusyuusystem/scripts/scroll-enhance.js
pusyuusystem/scripts/pusyuuImageEffect.js
